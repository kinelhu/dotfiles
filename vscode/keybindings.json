// Place your key bindings in this file to override the defaults
[
    {
        "key": "Cmd+Shift+m",
        "command": "type",
        "args": { "text": "%>%" },
        "when": "(editorTextFocus | terminalFocus) && editorLangId == r"
    },
    {
        "key": "Cmd+Shift+d",
        "command": "workbench.action.tasks.runTask",
        "args": "mdslides --draft",
        "when": "editorLangId == markdown || editorLangId == quarto"
    }
]